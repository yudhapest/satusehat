{
  "name": "@digitalmedika/satusehat",
  "version": "0.10.3",
  "description": "Type-safe TypeScript wrapper for SATUSEHAT API.",
  "author": "Digital Medika",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digitalmedika/satusehat.git"
  },
  "bugs": {
    "url": "https://github.com/digitalmedika/satusehat/issues"
  },
  "funding": {
    "url": "https://saweria.co/digitalmedika"
  },
  "homepage": "https://github.com/digitalmedika/satusehat#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:js": "esbuild ./src/index.ts --bundle --format=esm --platform=node --target=node24 --packages=external --outfile=./dist/index.js",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "npm run build:js && npm run build:types",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "smoke:live": "tsx --env-file-if-exists=.env ./scripts/live-smoke-test.ts",
    "smoke:sandbox": "tsx --env-file-if-exists=.env ./scripts/sandbox-check.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "verify": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "satusehat",
    "kemkes",
    "kemenkes",
    "fhir",
    "hl7-fhir",
    "indonesia",
    "healthcare",
    "typescript",
    "sdk",
    "api-client"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
